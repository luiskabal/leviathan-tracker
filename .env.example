# PostgreSQL local. Docker Compose sustituye el host por "postgres" dentro del contenedor.
DATABASE_URL=postgresql://leviathan:leviathan@localhost:5432/leviathan?schema=public

# Servidor HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Scheduler y checks
SCHEDULER_ENABLED=true
CHECK_CRON=*/30 * * * *
CHECK_CONCURRENCY=3
CHECK_TIMEOUT_MS=30000
CHECK_RETRIES=2
CHECK_FAILURE_THRESHOLD=3

# Secretos: reemplazar localmente y nunca subir el archivo .env.
JOB_API_TOKEN=replace-with-a-long-random-token
DISCORD_WEBHOOK_URL=

# Identificación responsable ante sitios externos.
USER_AGENT=LeviathanTracker/1.0 (+contact@example.com)
